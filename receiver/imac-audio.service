[Unit]
Description=HDMI stereo audio to iMac speakers with live equalizer
After=sound.target
StartLimitIntervalSec=0

[Service]
Type=simple
RuntimeDirectory=imac-audio-status
RuntimeDirectoryMode=0755
Environment=PYTHONUNBUFFERED=1
Environment=ALSA_CONFIG_PATH=/opt/imac-receiver/receiver/audio-alsa.conf
EnvironmentFile=/etc/imac-audio.conf
ExecStart=/usr/bin/python3 /opt/imac-receiver/receiver/audio.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
